{
  "name": "kristole",
  "private": true,
  "version": "9.0.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "device:build": "vite build --watch --mode device --outDir dist-device",
    "device:serve": "vite preview --mode device --outDir dist-device --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
